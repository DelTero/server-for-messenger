# Local run (outside Docker):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/messenger

# Docker Compose run (inside Docker network):
DATABASE_URL=postgresql://postgres:postgres@db:5432/messenger

# Cloudflare TURN configuration
CLOUDFLARE_TURN_KEY_ID=...
CLOUDFLARE_TURN_API_TOKEN=...
CLOUDFLARE_TURN_TTL=86400

JWT_ACCESS_SECRET=JWT_ACCESS_SECRET
JWT_REFRESH_SECRET=JWT_REFRESH_SECRET

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=messenger